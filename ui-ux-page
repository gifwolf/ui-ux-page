<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title> ᴝgԸɹɹɹ  يرحب بكم</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    :root {
        --primary-color: #6C63FF;
        --primary-dark: #554fd8;
        --secondary-color: #FF6584;
        --dark-bg: #121212;
        --card-bg: #1E1E1E;
        --text-light: #E0E0E0;
        --text-muted: #A0A0A0;
        --success-color: #4CAF50;
        --border-radius: 16px;
        --transition: all 0.3s ease;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    body {
        font-family: 'Tajawal', sans-serif;
        background: linear-gradient(135deg, var(--dark-bg), #1a1a2e);
        color: var(--text-light);
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .container {
        width: 100%;
        max-width: 700px;
        text-align: center;
    }

    .card {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        padding: 30px;
        margin-bottom: 20px;
        text-align: center;
    }

    .header {
        margin-bottom: 20px;
    }

    #logo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 25px rgba(108, 99, 255, 0.5);
        border: 3px solid rgba(108, 99, 255, 0.3);
        margin-bottom: 15px;
        background: none;
        filter: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    #logo:hover {
        transform: scale(1.05);
        box-shadow: 0 0 40px rgba(108, 99, 255, 0.8);
    }

    h1 {
        font-size: 1.8rem;
        background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }

    .options-container {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin: 20px 0;
    }

    .option-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: var(--border-radius);
        padding: 10px 15px;
        cursor: pointer;
        transition: var(--transition);
        text-align: center;
        max-width: 130px;
        border: 2px solid transparent;
    }

    .option-card:hover {
        background: rgba(108, 99, 255, 0.1);
        transform: translateY(-2px);
    }

    .option-card.selected {
        border-color: var(--primary-color);
        background: rgba(108, 99, 255, 0.15);
    }

    .option-card i {
        font-size: 1.4rem;
        margin-bottom: 5px;
        color: var(--primary-color);
    }

    .option-card span {
        font-size: 0.9rem;
        font-weight: 600;
    }

    input[type="radio"] { display: none; }

    .input-group {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    #number {
        width: 70%;
        padding: 14px;
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--border-radius);
        color: var(--text-light);
        text-align: center;
    }

    .button-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
    }

    .btn {
        padding: 12px 25px;
        font-size: 1rem;
        font-weight: 600;
        border: none;
        border-radius: var(--border-radius);
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
    }

    .btn-secondary {
        background: linear-gradient(135deg, var(--secondary-color), #e05574);
        color: white;
    }

    .image-container {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        min-height: 280px;
        border-radius: var(--border-radius);
        overflow: hidden;
        animation: glowBorder 4s infinite linear;
        background: rgba(255,255,255,0.03);
        padding: 20px;
    }

    @keyframes glowBorder {
        0% { box-shadow: 0 0 10px var(--primary-color), inset 0 0 10px var(--primary-color); }
        50% { box-shadow: 0 0 25px var(--secondary-color), inset 0 0 25px var(--secondary-color); }
        100% { box-shadow: 0 0 10px var(--primary-color), inset 0 0 10px var(--primary-color); }
    }

    #resultImage {
        max-width: 230px;
        max-height: 230px;
        border-radius: 50%;
        display: none;
        animation: fadeIn 0.6s ease;
    }

    #resultImage.loaded {
        display: block;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }

    #noImageText {
        color: var(--text-muted);
        margin-top: 15px;
        font-size: 1.1rem;
    }

</style>
</head>
<body>
<div class="container">
    <div class="card">
        <div class="header">
            <img id="logo" src="https://palringo.com/avatar.php?id=28044260&size=214" alt="شعار">
            <h1>ᴝgԸɹɹɹ يرحب بكم</h1>
        </div>

        <div class="options-container">
            <label class="option-card" for="membership">
                <input type="radio" id="membership" name="id_type" value="membership" required>
                <i class="fas fa-user"></i>
                <span>عضوية</span>
            </label>
            <label class="option-card" for="room">
                <input type="radio" id="room" name="id_type" value="room" required>
                <i class="fas fa-users"></i>
                <span>غرفة</span>
            </label>
        </div>

        <form id="imageForm">
            <div class="input-group">
                <input type="text" id="number" placeholder="أدخل الرقم هنا" required>
            </div>
            <div class="button-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-eye"></i> عرض الصورة
                </button>
                <button type="button" id="saveButton" class="btn btn-secondary" style="display: none;">
                    <i class="fas fa-download"></i> حفظ الصورة
                </button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="image-container">
            <img id="resultImage" alt="سيتم عرض الصورة هنا">
            <p id="noImageText" style="display:none;">لا توجد صورة متاحة</p>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const resultImage = document.getElementById("resultImage");
    const saveButton = document.getElementById("saveButton");
    const noImageText = document.getElementById("noImageText");
    const optionCards = document.querySelectorAll('.option-card');

    optionCards.forEach(card => {
        card.addEventListener('click', function() {
            optionCards.forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');
        });
    });

    document.getElementById("imageForm").addEventListener("submit", function(event) {
        event.preventDefault();
        const selectedOption = document.querySelector('.option-card.selected');
        if (!selectedOption) {
            alert("يرجى اختيار نوع الصورة (عضوية أو غرفة).");
            return;
        }

        const idType = selectedOption.querySelector('input').value;
        const number = document.getElementById("number").value;
        if (!number) {
            alert("يرجى إدخال الرقم.");
            return;
        }

        let fileUrl = "";
        if (idType === "membership") {
            fileUrl = `https://www.palringo.com/avatar.php?id=${number}&size=214`;
        } else {
            fileUrl = `https://www.palringo.com/avatar.php?id=${number}&type=g&size=large`;
        }

        const img = new Image();
        img.onload = function() {
            resultImage.src = fileUrl;
            resultImage.classList.add('loaded');
            saveButton.style.display = "flex";
            noImageText.style.display = "none";
        };
        img.onerror = function() {
            resultImage.classList.remove('loaded');
            saveButton.style.display = "none";
            noImageText.style.display = "block";
        };
        img.src = fileUrl;
    });

    saveButton.addEventListener("click", function() {
        const link = document.createElement("a");
        link.href = resultImage.src;
        link.download = "avatar.png";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
</script>
</body>
</html>
